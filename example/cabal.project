packages:
  common
  frontend

optional-packages:
  static/generated
  ../reflex-gadt-api.cabal

if !(arch(javascript) || arch(wasm32))
  packages:
    backend

  optional-packages:
    frontend/js
    frontend/wasm
    static/generated/custom

constraints: aeson-qq == 0.8.4

write-ghc-environment-files: never

multi-repl: True

-- Mirrors the nix module's `optimizations.all = true`, so plain-cabal builds
-- get the same flags as `nix-build`. ob-run/ob-repl override these with
-- -O0 -fno-* on the command line for fast rebuilds.
package *
  ghc-options:
    -O2
    -fexpose-all-unfoldings
    -fspecialise
    -fspecialise-aggressively
    -flate-specialise
    -fcross-module-specialise

if !(arch(javascript) || arch(wasm32))
  package reflex-dom
    flags: +use-warp -webkit2gtk

if arch(wasm32)
  shared: True
